# ============================================================
# GROQ (free tier) - https://console.groq.com/keys
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# SUPABASE - https://supabase.com/dashboard
# Project Settings -> API (URL + anon key) and Database (connection string)
# ============================================================
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection string used by SQLAlchemy (backend only)
# Dashboard -> Connect -> Session pooler URI (port 5432), include ?sslmode=require
DATABASE_URL=

# ============================================================
# LOCAL EMBEDDINGS (384 dimensions)
# ============================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# development | production
APP_ENV=development

# FastAPI base URL used by the Streamlit frontend
API_BASE_URL=http://localhost:8000
